{
  "name": "envprobe",
  "version": "0.1.0",
  "description": "Safe machine capability scanner for assigning agent build and test work.",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "src",
    "docs",
    "examples",
    "requirements",
    "scripts",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "scripts": {
    "check": "node --check src/index.js && node --check src/cli.js",
    "test": "node --test",
    "build": "node --check src/index.js && node --check src/cli.js",
    "smoke": "bash scripts/smoke.sh",
    "package:smoke": "npm pack --dry-run",
    "release:check": "npm run build && npm test && npm run smoke && npm run package:smoke"
  },
  "keywords": [
    "agents",
    "environment",
    "capabilities",
    "scanner",
    "cli"
  ],
  "author": "Roger Chappel",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rogerchappel/envprobe.git"
  },
  "bugs": {
    "url": "https://github.com/rogerchappel/envprobe/issues"
  },
  "homepage": "https://github.com/rogerchappel/envprobe#readme",
  "bin": {
    "envprobe": "./src/cli.js"
  }
}
