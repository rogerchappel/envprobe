{
  "name": "envprobe",
  "version": "0.1.0",
  "description": "Safe machine capability scanner for assigning agent build and test work.",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "src",
    "docs",
    "examples",
    "requirements",
    "scripts",
    "README.md"
  ],
  "scripts": {
    "check": "node --check src/index.js && node --check src/cli.js",
    "test": "node --test",
    "build": "node --check src/index.js && node --check src/cli.js",
    "smoke": "bash scripts/smoke.sh",
    "release:check": "npm run build && npm test && npm run smoke && npm pack --dry-run"
  },
  "keywords": [
    "agents",
    "environment",
    "capabilities",
    "scanner",
    "cli"
  ],
  "author": "StackForge User",
  "license": "MIT",
  "bin": {
    "envprobe": "./src/cli.js"
  }
}
